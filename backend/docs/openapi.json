{
  "openapi": "3.0.3",
  "info": {
    "title": "Resume Mini-Brain & Grounded Resume Tailoring API",
    "description": "API documentation for the merit-gate backend supporting resume tailoring, memory parsing, and vector retrieval using Gemini embeddings and MongoDB Atlas.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter the JWT token obtained from register or login endpoints."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "643e2f1b80c35f2a74ab8912"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "643e2f1b80c35f2a74ab8912"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "65b2a3f9e8a04b12c89f5c22"
          },
          "userId": {
            "type": "string",
            "example": "643e2f1b80c35f2a74ab8912"
          },
          "title": {
            "type": "string",
            "example": "E-Commerce Microservices Migration"
          },
          "description": {
            "type": "string",
            "example": "Migrated legacy monolith to AWS microservices utilizing Node.js, Express, and MongoDB."
          },
          "status": {
            "type": "string",
            "example": "active"
          },
          "memoryCount": {
            "type": "integer",
            "example": 15
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-01T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-01T10:15:00.000Z"
          }
        }
      },
      "UploadedProjectFile": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "File uploaded"
          },
          "fileName": {
            "type": "string",
            "example": "1717262000000-Generative-AI-Storytelling-Platform.md",
            "description": "Stored upload file name. Send this value as fileName in the ingest endpoint."
          },
          "originalName": {
            "type": "string",
            "example": "Generative AI Storytelling Platform.md"
          },
          "size": {
            "type": "integer",
            "example": 12345
          },
          "mimetype": {
            "type": "string",
            "example": "text/markdown"
          }
        }
      },
      "ProjectMemory": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "65b2a3f9e8a04b12c89f5c3a"
          },
          "userId": {
            "type": "string",
            "example": "643e2f1b80c35f2a74ab8912"
          },
          "projectId": {
            "type": "string",
            "example": "65b2a3f9e8a04b12c89f5c22"
          },
          "projectTitle": {
            "type": "string",
            "example": "E-Commerce Microservices Migration"
          },
          "memoryType": {
            "type": "string",
            "example": "strongest"
          },
          "rawBullet": {
            "type": "string",
            "example": "Led migrations of checkout service from Express.js monolith to AWS Lambda, reducing latency by 45%."
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Express.js",
              "AWS Lambda",
              "Node.js"
            ]
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "microservices",
              "latency"
            ]
          },
          "senioritySignals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "led",
              "migration"
            ]
          },
          "impactMetrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "45%"
            ]
          },
          "embeddingStatus": {
            "type": "string",
            "example": "done"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TailoringResponse": {
        "type": "object",
        "properties": {
          "tailoringRunId": {
            "type": "string",
            "example": "65b2a3f9e8a04b12c89f5c88"
          },
          "tailoredResumeId": {
            "type": "string",
            "example": "65b2a3f9e8a04b12c89f5c89"
          },
          "jdMetadata": {
            "type": "object",
            "properties": {
              "technologies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "Node.js",
                  "AWS",
                  "MongoDB"
                ]
              },
              "concepts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "scalability",
                  "microservices"
                ]
              },
              "roleType": {
                "type": "string",
                "example": "engineer"
              },
              "seniority": {
                "type": "string",
                "example": "senior"
              }
            }
          },
          "tailoredBullets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Architected node-based checkout flow serving 1M+ active users using AWS Lambda microservices.",
              "Spearheaded database query optimization for MongoDB Atlas, improving search response time by 30%."
            ]
          },
          "retrievedMemories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "memoryId": {
                  "type": "string",
                  "example": "65b2a3f9e8a04b12c89f5c3a"
                },
                "score": {
                  "type": "number",
                  "example": 0.88
                },
                "rawBullet": {
                  "type": "string",
                  "example": "Led migrations of checkout service from Express.js monolith to AWS Lambda, reducing latency by 45%."
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user",
        "description": "Creates a new user profile and returns a JWT access token. No authorization token is required for this endpoint.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "example": "john.doe@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "Password123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "User already exists or validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "User already exists"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user & get token",
        "description": "Logs in the user with their email and password and returns a JWT access token. No authorization token is required.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "john.doe@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "Password123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Invalid email or password"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "summary": "Get authenticated user profile",
        "description": "Returns details of the currently logged-in user. Requires a valid JWT token in headers.",
        "responses": {
          "200": {
            "description": "User profile details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Not authorized, token missing or invalid"
          }
        }
      }
    },
    "/api/projects": {
      "post": {
        "summary": "Create a new project",
        "description": "Creates a top-level container project for career experiences.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "E-Commerce Microservices Migration"
                  },
                  "description": {
                    "type": "string",
                    "example": "Migrated legacy monolith to AWS microservices utilizing Node.js, Express, and MongoDB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List all user projects",
        "description": "Retrieves all projects owned by the authenticated user sorted by creation date.",
        "responses": {
          "200": {
            "description": "List of projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/upload": {
      "post": {
        "summary": "Upload project markdown/text file",
        "description": "Uploads a .md, .markdown, or .txt project file to the backend public/uploads folder and returns the stored fileName to use with the ingest endpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Markdown or text file containing project resume bullets."
                  }
                }
              },
              "encoding": {
                "file": {
                  "contentType": "text/markdown,text/plain"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadedProjectFile"
                }
              }
            }
          },
          "400": {
            "description": "Missing file, invalid extension, or file too large"
          },
          "401": {
            "description": "Not authorized"
          }
        }
      }
    },
    "/api/projects/{id}": {
      "get": {
        "summary": "Get specific project details",
        "description": "Retrieves the project details and appends the total memory (bullet points) count.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Valid MongoDB ObjectId of the project",
            "schema": {
              "type": "string",
              "example": "65b2a3f9e8a04b12c89f5c22"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project details with memoryCount",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "404": {
            "description": "Project not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a project",
        "description": "Deletes the project container and cascades deletions to related ProjectMemory and pending EmbeddingJob records.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Valid MongoDB ObjectId of the project",
            "schema": {
              "type": "string",
              "example": "65b2a3f9e8a04b12c89f5c22"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project and associated items deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Project deleted"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/projects/{id}/ingest": {
      "post": {
        "summary": "Ingest project memories from raw text or uploaded file",
        "description": "Parses structured project intelligence into categorized memories and queues background jobs for Gemini embeddings. Send either rawText directly or a fileName returned by POST /api/projects/upload.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Valid MongoDB ObjectId of the project",
            "schema": {
              "type": "string",
              "example": "65b2a3f9e8a04b12c89f5c22"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "anyOf": [
                  {
                    "required": [
                      "rawText"
                    ]
                  },
                  {
                    "required": [
                      "fileName"
                    ]
                  }
                ],
                "properties": {
                  "rawText": {
                    "type": "string",
                    "description": "Structured project bullet text. Use this for direct ingest without uploading a file first.",
                    "example": "Top 5 Strongest Bullets\n- Led migrations of checkout service from Express.js monolith to AWS Lambda, reducing latency by 45%.\n- Designed a distributed caching layer using Redis, scaling throughput to 50k RPS.\n\nTop 5 ATS Keyword-Heavy Bullets\n- Implemented responsive React frontend dashboards communicating via RESTful Node APIs and WebSockets.\n- Provisioned infrastructure on AWS (EC2, ECS, RDS) with Terraform for automated CI/CD deployment."
                  },
                  "fileName": {
                    "type": "string",
                    "description": "Stored file name returned by POST /api/projects/upload. Backend reads this file from public/uploads.",
                    "example": "1717262000000-Generative-AI-Storytelling-Platform.md"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Text parsed successfully and embedding jobs queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Memories parsed and embedding jobs queued"
                    },
                    "parsedCount": {
                      "type": "integer",
                      "example": 4
                    },
                    "queuedCount": {
                      "type": "integer",
                      "example": 4
                    },
                    "memoryIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "65b2a3f9e8a04b12c89f5c3a",
                        "65b2a3f9e8a04b12c89f5c3b"
                      ]
                    },
                    "embeddingJobIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "65b2a3f9e8a04b12c89f5c40",
                        "65b2a3f9e8a04b12c89f5c41"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/projects/{id}/memories": {
      "get": {
        "summary": "List memories belonging to a project",
        "description": "Retrieves all parsed bullet points/memories for a specific project.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Valid MongoDB ObjectId of the project",
            "schema": {
              "type": "string",
              "example": "65b2a3f9e8a04b12c89f5c22"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of memories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectMemory"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/projects/{id}/embedding-status": {
      "get": {
        "summary": "Get project embedding status overview",
        "description": "Retrieves counters for memories and background embedding jobs to monitor queue completion.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Valid MongoDB ObjectId of the project",
            "schema": {
              "type": "string",
              "example": "65b2a3f9e8a04b12c89f5c22"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Embedding status overview",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "projectId": {
                      "type": "string",
                      "example": "65b2a3f9e8a04b12c89f5c22"
                    },
                    "memories": {
                      "type": "object",
                      "properties": {
                        "pending": {
                          "type": "integer",
                          "example": 0
                        },
                        "processing": {
                          "type": "integer",
                          "example": 0
                        },
                        "done": {
                          "type": "integer",
                          "example": 4
                        },
                        "failed": {
                          "type": "integer",
                          "example": 0
                        },
                        "total": {
                          "type": "integer",
                          "example": 4
                        }
                      }
                    },
                    "jobs": {
                      "type": "object",
                      "properties": {
                        "pending": {
                          "type": "integer",
                          "example": 0
                        },
                        "processing": {
                          "type": "integer",
                          "example": 0
                        },
                        "done": {
                          "type": "integer",
                          "example": 4
                        },
                        "failed": {
                          "type": "integer",
                          "example": 0
                        }
                      }
                    },
                    "ready": {
                      "type": "boolean",
                      "example": true
                    },
                    "hasFailures": {
                      "type": "boolean",
                      "example": false
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/projects/{id}/embedding-retry": {
      "post": {
        "summary": "Retry failed project embedding jobs",
        "description": "Resets failed embedding jobs for this project back to pending and requeues them in Redis. Use this after fixing embedding configuration or transient provider errors.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Valid MongoDB ObjectId of the project",
            "schema": {
              "type": "string",
              "example": "65b2a3f9e8a04b12c89f5c22"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Failed embedding jobs were requeued or no failed jobs were found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Failed embedding jobs requeued"
                    },
                    "queuedCount": {
                      "type": "integer",
                      "example": 25
                    },
                    "embeddingJobIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "66a1dbee502c1ae89f351b055",
                        "66a1dbee502c1ae89f351b056"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/tailoring/run": {
      "post": {
        "summary": "Execute grounded resume tailoring run",
        "description": "Submits a Job Description (JD) and a list of target Project IDs. Runs a hybrid vector + tag search across those projects, embeds the JD, retrieves the most relevant memories, and instructs Gemini to generate tailored, grounded bullet points.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jobDescription"
                ],
                "properties": {
                  "jobDescription": {
                    "type": "string",
                    "example": "We are seeking a Senior Backend Engineer proficient in Node.js, Express, and AWS services. Experience building microservices and optimizing database queries is key."
                  },
                  "projectIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "65b2a3f9e8a04b12c89f5c22"
                    ]
                  },
                  "jobTitle": {
                    "type": "string",
                    "example": "Senior Backend Engineer"
                  },
                  "companyName": {
                    "type": "string",
                    "example": "Stripe"
                  },
                  "memoryType": {
                    "type": "string",
                    "enum": [
                      "strongest",
                      "ats",
                      "product_company",
                      "startup"
                    ],
                    "example": "strongest"
                  },
                  "topK": {
                    "type": "integer",
                    "example": 20,
                    "description": "Number of candidates for vector search (1-100)"
                  },
                  "topN": {
                    "type": "integer",
                    "example": 10,
                    "description": "Number of final retrieved bullets (1-30)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tailoring run executed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TailoringResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tailoring/runs": {
      "get": {
        "summary": "List tailoring runs",
